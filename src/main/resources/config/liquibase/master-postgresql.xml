<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- Separate history preserves checksums of already-applied MySQL changesets. -->
    <property name="datetimeType" value="timestamp" dbms="postgresql"/>
    <preConditions onFail="HALT"><dbms type="postgresql"/></preConditions>
    <include file="config/liquibase/changelog/postgresql/00000000000000_initial_schema.xml"/>
    <include file="config/liquibase/changelog/postgresql/00000000000002_add_post_entity.xml"/>
    <include file="config/liquibase/changelog/00000000000003_add_comment_entity.xml"/>
    <include file="config/liquibase/changelog/00000000000004_add_follow_entity.xml"/>
    <include file="config/liquibase/changelog/00000000000005_add_like_entity.xml"/>
    <include file="config/liquibase/changelog/00000000000006_add_share_entity.xml"/>
</databaseChangeLog>
